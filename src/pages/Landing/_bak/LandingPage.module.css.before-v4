.wrap { max-width: 60rem; margin: 0 auto; padding: 0 1.25rem 3rem; }
.hero { padding: 2.5rem 0 2.5rem; }
.crumbs { font-size: .82rem; color: #999; margin-bottom: 1.5rem; }
.crumbs a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
.eyebrow { margin: 0 0 .75rem; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #b57a00; }
.title { font-size: 2.3rem; font-weight: 500; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 1.1rem; max-width: 48rem; }
@media (min-width: 640px)  { .title { font-size: 3.1rem; } }
@media (min-width: 1024px) { .title { font-size: 3.6rem; } }
.lead { font-size: 1.12rem; line-height: 1.65; color: #555; max-width: 42rem; margin: 0; }
.ctaRow { display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: center; margin: 1.75rem 0 1rem; }
.btn { display: inline-block; padding: .75rem 2rem; border-radius: 9999px; background: #111; color: #fff; font-weight: 500; font-size: .95rem; text-decoration: none; transition: background .2s, color .2s; }
.btn:hover { background: #1a1a2e; color: #fdb840; }
.link { color: #111; text-decoration: underline; text-underline-offset: 4px; font-size: .95rem; }
.trust { margin: 0; font-size: .85rem; color: #888; }

.section { padding: 2.5rem 0; border-top: 1px solid #e6e2d8; }
.h2 { display: flex; align-items: baseline; gap: .9rem; font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 1.25rem; }
.num { font-size: 1rem; font-weight: 600; color: #fdb840; letter-spacing: .05em; font-variant-numeric: tabular-nums; }

.dashList, .tickList { list-style: none; padding: 0; margin: 0; }
.dashList li { position: relative; padding: .5rem 0 .5rem 1.5rem; color: #333; line-height: 1.6; }
.dashList li::before { content: "?"; position: absolute; left: 0; color: #fdb840; font-weight: 700; }
.tickList { display: grid; grid-template-columns: 1fr; column-gap: 2.5rem; }
@media (min-width: 720px) { .tickList { grid-template-columns: 1fr 1fr; } }
.tickList li { position: relative; padding: .5rem 0 .5rem 1.5rem; color: #333; line-height: 1.55; }
.tickList li::before { content: "✓"; position: absolute; left: 0; color: #fdb840; font-weight: 700; }

.steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
@media (min-width: 720px) { .steps { grid-template-columns: repeat(4, 1fr); } }
.steps li { border-top: 2px solid #111; padding-top: .8rem; }
.steps li span { font-size: .8rem; font-weight: 600; color: #b57a00; }
.steps h3 { margin: .2rem 0 .4rem; font-weight: 500; font-size: 1.1rem; }
.steps p { margin: 0; color: #666; font-size: .92rem; line-height: 1.6; }

.setup { margin: 0 0 1rem; color: #444; line-height: 1.6; max-width: 46rem; }
.note { margin: 1rem 0 0; font-size: .92rem; color: #555; line-height: 1.6; max-width: 46rem; padding-left: 1rem; border-left: 3px solid #fdb840; }
.tableWrap { overflow-x: auto; }
.table { width: 100%; border-collapse: collapse; font-size: .93rem; font-variant-numeric: tabular-nums; }
.table th { text-align: left; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: #777; font-weight: 600; padding: .6rem .9rem .6rem 0; border-top: 2px solid #111; border-bottom: 1px solid #111; }
.table td { padding: .65rem .9rem .65rem 0; border-bottom: 1px solid #e6e2d8; color: #333; vertical-align: top; line-height: 1.5; }
.table tbody tr:last-child td { border-bottom: 2px solid #111; }

.mistakes { margin: 0; padding-left: 1.4rem; display: grid; gap: .9rem; }
.mistakes li { color: #444; line-height: 1.65; padding-left: .3rem; }
.mistakes li::marker { color: #b57a00; font-weight: 600; }
.mistakes strong { color: #111; font-weight: 600; }

.faq { border-bottom: 1px solid #e6e2d8; padding: .9rem 0; }
.faq summary { cursor: pointer; font-weight: 500; }
.faq p { margin: .6rem 0 0; color: #555; line-height: 1.65; max-width: 46rem; }

.related { list-style: none; padding: 0; margin: 0; display: flex; gap: .5rem 1.75rem; flex-wrap: wrap; }
.related a { color: #111; text-decoration: underline; text-underline-offset: 4px; }
.related a:hover { color: #b57a00; }

.hubList { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem 3rem; grid-template-columns: 1fr; }
@media (min-width: 720px) { .hubList { grid-template-columns: 1fr 1fr; } }
.hubList a { color: #111; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
.hubList a:hover { color: #b57a00; }
.hubList p { margin: .3rem 0 0; color: #666; font-size: .92rem; line-height: 1.55; }

.float { display: none; }
@media (max-width: 720px) {
  .float { display: inline-block; position: fixed; right: 1rem; bottom: 1rem; z-index: 40; padding: .7rem 1.4rem; border-radius: 9999px; background: #111; color: #fdb840; font-weight: 500; font-size: .9rem; text-decoration: none; box-shadow: 0 6px 20px rgba(0,0,0,.2); }
}
