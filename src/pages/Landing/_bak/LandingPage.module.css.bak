.page { --ink:#12202f; --muted:#51606f; --brand:#0b6e4f; --brand-d:#085540; --bg:#fff; --alt:#f4f8f6; color:var(--ink); background:var(--bg); line-height:1.65; }
.wrap { max-width:1040px; margin:0 auto; padding:0 20px; }
.hero { padding:72px 0 56px; background:linear-gradient(180deg,#eaf5f0,#fff); }
.hero h1 { font-size:clamp(1.9rem,4.5vw,3rem); line-height:1.15; margin:12px 0 16px; }
.crumbs { font-size:.85rem; color:var(--muted); }
.crumbs a { color:var(--brand); text-decoration:none; }
.lead { font-size:1.15rem; color:var(--muted); max-width:720px; }
.ctaRow { display:flex; gap:12px; flex-wrap:wrap; margin:24px 0 16px; }
.btn, .btnGhost { display:inline-block; padding:14px 26px; border-radius:10px; font-weight:700; text-decoration:none; }
.btn { background:var(--brand); color:#fff; }
.btn:hover { background:var(--brand-d); }
.btnGhost { border:2px solid var(--brand); color:var(--brand); }
.badges { display:flex; gap:8px 22px; flex-wrap:wrap; list-style:none; padding:0; margin:8px 0 0; font-size:.9rem; color:var(--muted); }
.badges li::before { content:"✓ "; color:var(--brand); font-weight:700; }
.section { padding:56px 0; }
.alt { background:var(--alt); }
.section h2, .final h2 { font-size:1.7rem; margin:0 0 20px; }
.checks { list-style:none; padding:0; display:grid; gap:10px; }
.checks li { padding:14px 16px 14px 44px; background:var(--alt); border-radius:10px; position:relative; }
.checks li::before { content:"?"; position:absolute; left:14px; top:12px; width:22px; height:22px; border-radius:50%; background:var(--brand); color:#fff; font-size:.8rem; display:grid; place-items:center; font-weight:700; }
.cards { list-style:none; padding:0; display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; }
.cards li { background:#fff; border:1px solid #dbe6e1; border-radius:12px; padding:18px; }
.cards a { color:var(--brand); text-decoration:none; }
.cards p { margin:8px 0 0; color:var(--muted); font-size:.95rem; }
.steps { list-style:none; padding:0; display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; }
.steps li span { display:grid; place-items:center; width:38px; height:38px; border-radius:50%; background:var(--brand); color:#fff; font-weight:700; }
.steps h3 { margin:10px 0 4px; }
.steps p { margin:0; color:var(--muted); }
.faq { background:#fff; border:1px solid #dbe6e1; border-radius:10px; padding:14px 18px; margin-bottom:10px; }
.faq summary { cursor:pointer; font-weight:700; }
.faq p { margin:10px 0 0; color:var(--muted); }
.related { list-style:none; padding:0; display:flex; gap:12px; flex-wrap:wrap; }
.related a { display:inline-block; padding:10px 16px; border-radius:999px; background:var(--alt); color:var(--brand); text-decoration:none; font-weight:600; }
.final { text-align:center; padding:64px 0; background:var(--brand); color:#fff; }
.final .btn { background:#fff; color:var(--brand); margin-top:12px; }
@media (prefers-color-scheme: dark) { .page { --ink:#e8eef2; --muted:#a8b6c2; --bg:#0f1720; --alt:#16212c; } .hero { background:linear-gradient(180deg,#14261f,#0f1720); } .cards li, .faq { background:#16212c; border-color:#26364a; } }
