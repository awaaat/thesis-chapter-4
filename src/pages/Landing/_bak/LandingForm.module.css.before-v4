.wrap { display: grid; gap: 2rem; grid-template-columns: 1fr; padding: 3rem 0 2rem; border-top: 1px solid #e6e2d8; scroll-margin-top: 90px; }
@media (min-width: 900px) { .wrap { grid-template-columns: 1fr 1.15fr; gap: 4rem; } }
.h2 { font-size: 2rem; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 .6rem; }
.sub { color: #555; margin: 0 0 1.5rem; line-height: 1.65; }
.small { margin: 1.25rem 0 .4rem; font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #888; }
.list { list-style: none; padding: 0; margin: 0; }
.list li { position: relative; padding: .25rem 0 .25rem 1.3rem; color: #444; font-size: .95rem; }
.list li::before { content: "✓"; position: absolute; left: 0; color: #fdb840; font-weight: 700; }
.side a { color: #111; text-decoration: underline; text-underline-offset: 3px; }
.form { display: flex; flex-direction: column; gap: 1rem; }
.form label { display: flex; flex-direction: column; gap: .3rem; font-size: .85rem; font-weight: 500; color: #444; }
.row { display: grid; gap: 1rem; grid-template-columns: 1fr; }
@media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
.form input, .form select, .form textarea { width: 100%; box-sizing: border-box; padding: .65rem .8rem; border: 1px solid #d9d4c7; border-radius: .6rem; background: #fff; font: inherit; font-weight: 400; color: #111; }
.form input:focus, .form select:focus, .form textarea:focus { outline: none; border-color: #fdb840; box-shadow: 0 0 0 3px rgba(253,184,64,.22); }
.form textarea { resize: vertical; }
.form button { padding: .8rem 2rem; border: 0; border-radius: 9999px; background: #111; color: #fff; font: inherit; font-weight: 500; cursor: pointer; transition: background .2s, color .2s; }
.form button:hover:not(:disabled) { background: #1a1a2e; color: #fdb840; }
.form button:disabled { opacity: .6; cursor: not-allowed; }
.error { background: #fde8e8; color: #b91c1c; padding: .7rem 1rem; border-radius: .6rem; font-size: .9rem; }
.note { margin: 0; font-size: .75rem; color: #999; text-align: center; }
.hp { position: absolute !important; left: -9999px !important; height: 0 !important; width: 0 !important; opacity: 0 !important; }
.again { margin-top: .5rem; padding: .6rem 1.5rem; border: 1px solid #111; border-radius: 9999px; background: transparent; font: inherit; cursor: pointer; width: fit-content; }
