.wrap { max-width: 40rem; margin: 0 auto; padding: 2.5rem 0 4rem; border-top: 1px solid #eee; scroll-margin-top: 90px; }
.h2 { font-size: 1.9rem; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 .4rem; }
.sub { color: #666; margin: 0 0 1.5rem; line-height: 1.6; }
.form { display: flex; flex-direction: column; gap: 1rem; }
.form label { display: flex; flex-direction: column; gap: .3rem; font-size: .85rem; font-weight: 500; color: #444; }
.row { display: grid; gap: 1rem; grid-template-columns: 1fr; }
@media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
.form input, .form select, .form textarea { width: 100%; box-sizing: border-box; padding: .65rem .8rem; border: 1px solid #ddd; border-radius: .6rem; background: #fff; font: inherit; font-weight: 400; }
.form input:focus, .form select:focus, .form textarea:focus { outline: none; border-color: #fdb840; box-shadow: 0 0 0 3px rgba(253,184,64,.2); }
.form textarea { resize: vertical; }
.form button { padding: .75rem 2rem; border: 0; border-radius: 9999px; background: #111; color: #fff; font: inherit; font-weight: 500; cursor: pointer; transition: background .2s, color .2s; }
.form button:hover:not(:disabled) { background: #1a1a2e; color: #fdb840; }
.form button:disabled { opacity: .6; cursor: not-allowed; }
.error { background: #fde8e8; color: #b91c1c; padding: .7rem 1rem; border-radius: .6rem; font-size: .9rem; }
.note { margin: 0; font-size: .75rem; color: #999; text-align: center; }
